---
const skills = [
  { category: "Languages", items: ["Python", "C", "Rust", "JavaScript", "TypeScript", "Kotlin", "Shell"] },
  { category: "Frameworks", items: ["SvelteKit", "Next.js", "Astro", "Tauri", "GTK4", "Qt6"] },
  { category: "Infrastructure", items: ["Docker", "PostgreSQL", "Redis", "MinIO", "Nginx", "SQLite"] },
  { category: "Environment", items: ["Arch Linux", "KDE Plasma", "Neovim", "Git"] },
];
---

<section id="about">
  <div class="section-header">
    <span class="mono label">About</span>
  </div>

  <div class="about-grid">
    <div class="about-text">
      <p class="bio-lead">
        I'm Ramdan Olii, a developer and student at Universitas Negeri Gorontalo, Indonesia.
      </p>
      <p class="bio-body">
        I build native Linux desktop applications, self-hosted web tools, and open-source infrastructure. Most of my work targets Arch Linux as the primary environment, favoring GTK4, Qt, Tauri, and WebKit-based wrappers for desktop and Node.js, SvelteKit, or Next.js for the web.
      </p>
      <p class="bio-body">
        My projects tend to live at the intersection of systems programming and everyday usability: things I actually need that don't exist yet, or exist but not on Linux.
      </p>
      <div class="bio-links">
        <a href="https://github.com/ramdanolii14" target="_blank" rel="noopener noreferrer" class="bio-link mono">
          GitHub ↗
        </a>
        <a href="https://blog.ramdanolii.my.id" target="_blank" rel="noopener noreferrer" class="bio-link mono">
          Blog ↗
        </a>
      </div>
    </div>

    <div class="about-skills">
      {skills.map((group) => (
        <div class="skill-group">
          <span class="skill-category mono">{group.category}</span>
          <div class="skill-items">
            {group.items.map(item => <span class="skill-item">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #about {
    padding: clamp(5rem, 12vh, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--grey-900);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey-500);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .bio-lead {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    font-family: var(--font-display);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .bio-body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--grey-300);
    margin-bottom: 1rem;
  }

  .bio-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .bio-link {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--white);
    border-bottom: 1px solid var(--grey-700);
    padding-bottom: 2px;
    transition: border-color 0.15s, color 0.15s;
  }

  .bio-link:hover {
    border-color: var(--white);
  }

  .about-skills {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .skill-category {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--grey-500);
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-item {
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--grey-900);
    padding: 0.3rem 0.65rem;
    transition: background 0.15s, color 0.15s;
  }

  .skill-item:hover {
    background: var(--white);
    color: var(--black);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
