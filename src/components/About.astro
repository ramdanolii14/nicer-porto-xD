---

<section id="about">
  <div class="section-header">
    <span class="mono label">About</span>
  </div>

  <div class="about-grid">
    <div class="about-text">
      <p class="bio-lead">
        I'm Ramdan Olii, a developer and student at Universitas Negeri Gorontalo, Indonesia.
      </p>
      <p class="bio-body">
        I build native Linux desktop applications, self-hosted web tools, and open-source infrastructure. Most of my work targets Arch Linux as the primary environment, favoring GTK4, Qt, Tauri, and WebKit-based wrappers for desktop and Node.js, SvelteKit, or Next.js for the web.
      </p>
      <p class="bio-body">
        My projects tend to live at the intersection of systems programming and everyday usability: things I actually need that don't exist yet, or exist but not on Linux.
      </p>
      <div class="bio-links">
        <a href="https://github.com/ramdanolii14" target="_blank" rel="noopener noreferrer" class="bio-link mono">
          GitHub ↗
        </a>
        <a href="https://blog.ramdanolii.my.id" target="_blank" rel="noopener noreferrer" class="bio-link mono">
          Blog ↗
        </a>
      </div>
    </div>

    <div class="about-skills">
      {skills.map((group) => (
        <div class="skill-group">
          <span class="skill-category mono">{group.category}</span>
          <div class="skill-items">
            {group.items.map(item => (
              <div class="skill-item-wrapper">
                <svg class="skill-icon" viewBox="0 0 24 24" fill="currentColor" set:html={item.icon} />
                <span class="skill-item">{typeof item === 'string' ? item : item.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #about {
    padding: clamp(5rem, 12vh, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .bio-lead {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    font-family: var(--font-display);
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .bio-body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .bio-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .bio-link {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 0.15s, color 0.15s;
  }

  .bio-link:hover {
    border-color: var(--text);
  }

  .about-skills {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .skill-category {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .skill-item-wrapper {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    background: var(--border-subtle);
    border-radius: 4px;
    transition: background 0.15s;
  }

  .skill-item-wrapper:hover {
    background: var(--text-secondary);
  }

  .skill-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.15s;
  }

  .skill-item-wrapper:hover .skill-icon {
    opacity: 1;
  }

  .skill-item {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
