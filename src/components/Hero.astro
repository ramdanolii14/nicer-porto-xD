---
---

<section id="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="mono">Gorontalo, Indonesia</span>
      <span class="dot">·</span>
      <span class="mono">Open Source</span>
    </div>

    <h1 class="hero-name">
      <span class="line-1">Ramdan</span>
      <span class="divider" aria-hidden="true"></span>
      <span class="line-2">Olii</span>
    </h1>

    <p class="hero-tagline">
      <span class="tagline-text" id="tagline"></span><span class="cursor" aria-hidden="true">_</span>
    </p>

    <div class="hero-meta">
      <span class="mono">Developer · Student · Linux Enthusiast</span>
    </div>

    <a href="#projects" class="scroll-cue" aria-label="Scroll to projects">
      <span class="mono">scroll</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 2v20M2 16l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

<style>
  #hero {
    height: 100vh;
    height: 100dvh;
    max-height: 100vh;
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: var(--nav-height) clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 3vh, 2rem);
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero-inner {
    width: 100%;
    max-width: 1200px;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    animation: hero-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
    color: var(--grey-500);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dot { color: var(--grey-700); }

  .hero-name {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
  }

  .line-1, .line-2 {
    display: block;
  }

  .divider {
    display: block;
    height: 1px;
    background: var(--grey-700);
    margin: clamp(0.35rem, 1vh, 0.5rem) 0;
  }

  .hero-tagline {
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    font-weight: 400;
    color: var(--grey-300);
    margin-bottom: clamp(0.5rem, 1.5vh, 1rem);
    font-family: var(--font-body);
    line-height: 1.45;
    min-height: 1.45em;
  }

  .cursor {
    display: inline-block;
    color: var(--white);
    animation: blink 1s step-end infinite;
    font-weight: 700;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .hero-meta {
    color: var(--grey-500);
    margin-bottom: clamp(1rem, 2.5vh, 1.75rem);
  }

  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: var(--grey-500);
    transition: color 0.15s, transform 0.2s;
  }

  .scroll-cue:hover {
    color: var(--white);
    transform: translateY(4px);
  }

  .scroll-cue .mono {
    font-size: 0.8rem;
  }
</style>

<script>
  const phrases = [
    "Nativeing apps that still aren't on Arch Linux.",
    "Porting web & Electron apps to true Linux natives.",
    "Kotlin · TypeScript · Python · JavaScript · C++ · Rust.",
    "Tauri · GTK4 · Qt · AUR packaging.",
    "Building desktop software Arch Linux deserves.",
  ];

  let phraseIdx = 0;
  let charIdx = 0;
  let deleting = false;
  let pause = 0;
  const el = document.getElementById('tagline');

  function type() {
    if (!el) return;
    const phrase = phrases[phraseIdx];

    if (pause > 0) { pause--; setTimeout(type, 80); return; }

    if (!deleting) {
      el.textContent = phrase.slice(0, ++charIdx);
      if (charIdx === phrase.length) { deleting = true; pause = 20; }
      setTimeout(type, 60);
    } else {
      el.textContent = phrase.slice(0, --charIdx);
      if (charIdx === 0) {
        deleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        pause = 6;
      }
      setTimeout(type, 35);
    }
  }

  type();
</script>
