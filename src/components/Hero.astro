---
---

<section id="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="mono">Indonesia</span>
      <span class="dot">·</span>
      <span class="mono">Gorontalo</span>
    </div>

<div class="name-and-pic">
<h1 class="hero-name">Ramdan Olii</h1>
  <img src="/profile-light.jpg" alt="Ramdan Olii" class="profile-pic profile-pic-light" />
  <img src="/profile-dark.jpg" alt="Ramdan Olii" class="profile-pic profile-pic-dark" />
</div>

    <p class="hero-tagline">
      <span class="tagline-text" id="tagline"></span><span class="cursor" aria-hidden="true">_</span>
    </p>

    <div class="hero-meta">
      <span class="mono">Engineering 2024</span>
    </div>

    <a href="#projects" class="scroll-cue" aria-label="Scroll to projects">
      <span class="mono">scroll</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 2v20M2 16l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

<style>
  #hero {
    height: 100vh;
    height: 100dvh;
    max-height: 100vh;
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: var(--nav-height) clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 3vh, 2rem);
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero-inner {
    width: 100%;
    max-width: 1200px;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    animation: hero-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
    color: var(--text-muted);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dot { color: var(--text-secondary); }

  .name-and-pic {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: clamp(0.5rem, 1vh, 0.75rem);
    width: 100%;
  }

  .hero-name {
    flex-shrink: 0;
  }

  .profile-pic {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-name {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    line-height: 1;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .profile-pic {
    width: clamp(120px, 25vw, 280px);
    height: clamp(120px, 25vw, 280px);
    border-radius: 0;
    object-fit: cover;
  }

  .profile-pic-light {
    display: block;
    border: 3px solid #000000;
  }

  .profile-pic-dark {
    display: none;
    border: 3px solid #ffffff;
  }

  html[data-theme="dark"] .profile-pic-light {
    display: none;
  }

  html[data-theme="dark"] .profile-pic-dark {
    display: block;
  }

  .line-1, .line-2 {
    display: inline;
  }

  .divider {
    display: none;
    height: 1px;
    background: var(--grey-700);
    margin: clamp(0.35rem, 1vh, 0.5rem) 0;
  }

  .hero-tagline {
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    font-weight: 400;
    color: var(--text-muted);
    margin-top: -0.5rem;
    margin-bottom: clamp(0.5rem, 1.5vh, 1rem);
    font-family: var(--font-body);
    line-height: 1.45;
    min-height: 1.45em;
  }

  .cursor {
    display: inline-block;
    color: var(--text);
    animation: blink 1s step-end infinite;
    font-weight: 700;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .hero-meta {
    color: var(--text-muted);
    margin-bottom: clamp(1rem, 2.5vh, 1.75rem);
  }

  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    transition: color 0.15s, transform 0.2s;
  }

  .scroll-cue:hover {
    color: var(--text);
    transform: translateY(4px);
  }

  .scroll-cue .mono {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    #hero {
      padding: var(--nav-height) 1rem clamp(1.25rem, 3vh, 2rem);
    }

    .name-and-pic {
      flex-direction: column;
      gap: 1rem;
      margin-bottom: clamp(0.5rem, 1.5vh, 1rem);
    }

    .hero-name {
      width: 100%;
      text-align: center;
      font-size: clamp(1.75rem, 5vw, 3rem);
    }

    .profile-pic {
      margin-left: 0;
      margin-right: 0;
      width: clamp(100px, 20vw, 200px);
      height: clamp(100px, 20vw, 200px);
    }

    .hero-tagline {
      font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    }

    .hero-eyebrow,
    .hero-meta {
      text-align: center;
      justify-content: center;
    }

    .scroll-cue {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    #hero {
      padding: var(--nav-height) 1rem 1rem;
    }

    .mono {
      font-size: 0.75rem;
    }

    .hero-name {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      gap: 0.25rem;
    }

    .profile-pic {
      width: clamp(80px, 18vw, 150px);
      height: clamp(80px, 18vw, 150px);
    }

    .hero-tagline {
      font-size: clamp(0.85rem, 1.6vw, 1rem);
      min-height: auto;
    }

    .scroll-cue .mono {
      font-size: 0.7rem;
    }

    .scroll-cue svg {
      width: 12px;
      height: 18px;
    }
  }
</style>

<script>
  const phrases = [
    "Kotlin · TypeScript · Python · JavaScript · C++ · Rust.",
    "Tauri · GTK4 · Qt · AUR packaging.",
    "Making a Fun Windows App.",
  ];

  let phraseIdx = 0;
  let charIdx = 0;
  let deleting = false;
  let pause = 0;
  const el = document.getElementById('tagline');

  function type() {
    if (!el) return;
    const phrase = phrases[phraseIdx];

    if (pause > 0) { pause--; setTimeout(type, 80); return; }

    if (!deleting) {
      el.textContent = phrase.slice(0, ++charIdx);
      if (charIdx === phrase.length) { deleting = true; pause = 20; }
      setTimeout(type, 60);
    } else {
      el.textContent = phrase.slice(0, --charIdx);
      if (charIdx === 0) {
        deleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        pause = 6;
      }
      setTimeout(type, 35);
    }
  }

  type();
</script>
