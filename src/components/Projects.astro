---
const projects = [
  {
    name: "WhatsApp Ultra Fast",
    description: "Lightweight WhatsApp Web client for Linux. Built with Tauri 2 + Rust + WebKit2GTK. Published on AUR.",
    tags: ["Rust", "Tauri", "GTK", "Linux"],
    url: "https://github.com/ramdanolii14",
    year: "2026",
  },
  {
    name: "DDRIVE",
    description: "Self-hosted file storage using Discord channels as a backend. Multi-bot pool for rate-limit management.",
    tags: ["Node.js", "Discord API", "Storage"],
    url: "https://github.com/ramdanolii14",
    year: "2026",
  },
  {
    name: "Drivepool",
    description: "Multi-account Google Drive dashboard. Built with Next.js 14 App Router, better-sqlite3, and googleapis.",
    tags: ["Next.js", "Google API", "SQLite"],
    url: "https://github.com/ramdanolii14",
    year: "2026",
  },
  {
    name: "IDR Spectrum Player",
    description: "GTK4/Python music player with real-time spectrum visualization styled as an IDR/USD exchange rate chart.",
    tags: ["Python", "GTK4", "Audio"],
    url: "https://github.com/ramdanolii14/Rplayer",
    year: "2026",
  },
  {
    name: "RaisaBrowser",
    description: "Custom web browser built in C++ with Qt6 WebEngine. Multi-file codebase, download GUI, infinite-scroll handling.",
    tags: ["C++", "Qt6", "WebEngine"],
    url: "https://github.com/ramdanolii14",
    year: "2026",
  },
];
---

<section id="projects">
  <div class="section-header">
    <span class="mono label">Selected Work</span>
  </div>

  <div class="projects-grid">
    {projects.map((p) => (
      <a href={p.url} target="_blank" rel="noopener noreferrer" class="project-card">
        <div class="card-top">
          <span class="project-year mono">{p.year}</span>
          <svg class="arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 15L15 3M15 3H7M15 3v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="project-name">{p.name}</h3>
        <p class="project-desc">{p.description}</p>
        <div class="project-tags">
          {p.tags.map(t => <span class="tag mono">{t}</span>)}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  #projects {
    padding: clamp(5rem, 12vh, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1px;
    border: 1px solid var(--border);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    border: none;
    background: var(--border-subtle);
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    outline-offset: -2px;
  }

  .project-card:hover {
    background: var(--text);
    color: var(--bg);
  }

  .project-card:hover .project-desc {
    color: var(--text-secondary);
  }

  .project-card:hover .project-year {
    color: var(--text-secondary);
  }

  .project-card:hover .tag {
    border-color: var(--text-secondary);
    color: var(--text-secondary);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-year {
    font-size: 0.8125rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .arrow {
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .project-card:hover .arrow {
    transform: translate(3px, -3px);
  }

  .project-name {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .project-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-secondary);
    flex: 1;
    transition: color 0.15s;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.2rem 0.5rem;
    transition: border-color 0.15s, color 0.15s;
  }

  @media (max-width: 768px) {
    #projects {
      padding: clamp(4rem, 10vh, 8rem) 1rem;
    }

    .projects-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 100%), 1fr));
    }

    .project-card {
      padding: 1.5rem;
    }

    .project-name {
      font-size: 1rem;
    }

    .project-desc {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    #projects {
      padding: clamp(3rem, 8vh, 6rem) 1rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 1.25rem;
      gap: 0.5rem;
    }

    .project-name {
      font-size: 0.95rem;
    }

    .project-desc {
      font-size: 0.85rem;
      line-height: 1.5;
    }

    .tag {
      font-size: 0.75rem;
      padding: 0.15rem 0.4rem;
    }
  }
</style>
