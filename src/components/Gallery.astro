---
import { Image } from 'astro:assets';

type ImageModule = { default: ImageMetadata };

// ─────────────────────────────────────────────────────────────────
// CARA PAKAI:
// Tambah foto ke folder  src/gallery/<category>/
// Format yang didukung : .jpg .jpeg .png .webp
// Rebuild site          : npm run build
// Foto langsung muncul di gallery otomatis — tanpa edit kode.
// ─────────────────────────────────────────────────────────────────

const rawCategories: Record<string, Record<string, ImageModule>> = {
  'Event':   import.meta.glob<ImageModule>('/src/gallery/event/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',   { eager: true }),
  'Kampus':  import.meta.glob<ImageModule>('/src/gallery/kampus/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',  { eager: true }),
  'Hobi':    import.meta.glob<ImageModule>('/src/gallery/hobi/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',    { eager: true }),
  'My Fav Coser': import.meta.glob<ImageModule>('/src/gallery/cosplay/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true }),
};

interface Photo {
  src: ImageMetadata;
  filename: string;
  category: string;
  index: number;
}

let globalIdx = 0;
const categories = Object.entries(rawCategories)
  .map(([name, modules]) => ({
    name,
    slug: name.toLowerCase(),
    photos: Object.entries(modules).map(([path, mod]) => ({
      src: mod.default,
      filename: path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '',
      category: name,
      index: globalIdx++,
    } as Photo)),
  }))
  .filter(c => c.photos.length > 0);

const allPhotos: Photo[] = categories.flatMap(c => c.photos);
const total = allPhotos.length;
---

<section id="gallery">
  <div class="section-header">
    <span class="mono label">Gallery</span>
    <span class="mono count">{total} photo{total !== 1 ? 's' : ''}</span>
  </div>

  <!-- Category filter -->
  <div class="filter-bar" role="tablist" aria-label="Filter gallery by category">
    <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">
      All <span class="pill">{total}</span>
    </button>
    {categories.map(c => (
      <button class="filter-btn" data-filter={c.slug} role="tab" aria-selected="false">
        {c.name} <span class="pill">{c.photos.length}</span>
      </button>
    ))}
  </div>

  <!-- Grid -->
  <div class="gallery-grid" id="gallery-grid">
    {allPhotos.map((photo) => (
      <button
        class="gallery-item"
        data-category={photo.category.toLowerCase()}
        data-index={photo.index}
        aria-label={`Open ${photo.filename} — ${photo.category}`}
      >
        <Image
          src={photo.src}
          alt={`${photo.category} — ${photo.filename}`}
          width={600}
          height={800}
          loading="lazy"
          decoding="async"
          class="gallery-img"
        />
        <div class="overlay">
          <span class="overlay-cat mono">{photo.category}</span>
          <span class="overlay-name">{photo.filename}</span>
        </div>
      </button>
    ))}
  </div>

  <!-- Empty state (shown when filter returns 0 results) -->
  <div class="empty-state" id="gallery-empty" hidden>
    <span class="mono">No photos in this category yet.</span>
  </div>
</section>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lb-close" id="lb-close" aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" id="lb-prev" aria-label="Previous photo">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="lb-nav lb-next" id="lb-next" aria-label="Next photo">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="lb-content">
    <img id="lb-img" src="" alt="" class="lb-photo" />
    <div class="lb-meta">
      <span class="lb-cat mono" id="lb-cat"></span>
      <span class="lb-name" id="lb-name"></span>
      <span class="lb-counter mono" id="lb-counter"></span>
    </div>
  </div>
</div>
<div id="lb-backdrop" class="lb-backdrop" hidden></div>

<style>
  #gallery {
    padding: clamp(5rem, 12vh, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--border);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .count {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1;
  }

  .filter-btn:hover {
    color: var(--text);
    border-color: var(--text-secondary);
  }

  .filter-btn.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .filter-btn.active .pill {
    background: var(--bg);
    color: var(--text);
  }

  .pill {
    font-size: 0.75rem;
    background: var(--border-subtle);
    color: var(--text-muted);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    transition: all 0.15s;
  }

  /* Gallery grid */
  .gallery-grid {
    columns: 4 220px;
    column-gap: 1px;
    gap: 1px;
  }

  .gallery-item {
    display: block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 1px;
    position: relative;
    overflow: hidden;
    background: var(--border-subtle);
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
  }

  .gallery-item:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .gallery-item.hidden {
    display: none;
  }

  .gallery-img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.35s ease;
    filter: brightness(0.9);
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.04);
    filter: brightness(1);
  }

  /* Hover overlay */
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .gallery-item:hover .overlay {
    opacity: 1;
  }

  .overlay-cat {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.2rem;
  }

  .overlay-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    font-family: var(--font-body);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Empty state */
  .empty-state {
    padding: 5rem 0;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  /* ── Lightbox ── */
  .lb-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.96);
    z-index: 200;
    cursor: zoom-out;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: lb-fade-in 0.2s ease;
  }

  @keyframes lb-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 201;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    pointer-events: none;
  }

  .lightbox[hidden] { display: none; }
  .lb-backdrop[hidden] { display: none; }

  .lb-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-height: 90vh;
    max-width: 90vw;
    pointer-events: auto;
    animation: lb-scale-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lb-scale-in {
    from { opacity: 0; transform: scale(0.95); }
    to   { opacity: 1; transform: scale(1); }
  }

  .lb-photo {
    display: block;
    max-height: calc(90vh - 80px);
    max-width: 90vw;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lb-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .lb-cat {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .lb-name {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    flex: 1;
  }

  .lb-counter {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    margin-left: auto;
  }

  /* Lightbox controls */
  .lb-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 202;
    background: transparent;
    border: 1px solid var(--text-secondary);
    color: var(--text-secondary);
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.15s;
    pointer-events: auto;
  }

  .lb-close:hover {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .lb-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 202;
    background: transparent;
    border: 1px solid var(--text-secondary);
    color: var(--text-secondary);
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
    pointer-events: auto;
  }

  .lb-nav:hover {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .lb-prev { left: 1.5rem; }
  .lb-next { right: 1.5rem; }

  @media (max-width: 600px) {
    .gallery-grid { columns: 2 140px; }
    .lb-prev { left: 0.5rem; }
    .lb-next { right: 0.5rem; }
  }
</style>

<script>
  // ── Photo data hydrated from DOM ──────────────────────────────
  const items = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item'));
  const photoData = items.map(el => ({
    el,
    category: el.dataset.category ?? '',
    index: Number(el.dataset.index),
    src: el.querySelector('img')?.src ?? '',
    alt: el.querySelector('img')?.alt ?? '',
    name: el.querySelector('.overlay-name')?.textContent ?? '',
    cat: el.querySelector('.overlay-cat')?.textContent ?? '',
  }));

  // ── Filter ────────────────────────────────────────────────────
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const empty = document.getElementById('gallery-empty')!;
  let activeFilter = 'all';

  function applyFilter(filter: string) {
    activeFilter = filter;
    let visible = 0;
    photoData.forEach(p => {
      const show = filter === 'all' || p.category === filter;
      p.el.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    empty.hidden = visible > 0;

    filterBtns.forEach(btn => {
      const isActive = btn.dataset.filter === filter;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', String(isActive));
    });
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
  });

  // ── Lightbox ──────────────────────────────────────────────────
  const lb         = document.getElementById('lightbox')!;
  const lbBackdrop = document.getElementById('lb-backdrop')!;
  const lbImg      = document.getElementById('lb-img') as HTMLImageElement;
  const lbCat      = document.getElementById('lb-cat')!;
  const lbName     = document.getElementById('lb-name')!;
  const lbCounter  = document.getElementById('lb-counter')!;
  const lbClose    = document.getElementById('lb-close')!;
  const lbPrev     = document.getElementById('lb-prev')!;
  const lbNext     = document.getElementById('lb-next')!;

  let currentVisible: typeof photoData = [];
  let currentPos = 0;

  function getVisible() {
    return photoData.filter(p => !p.el.classList.contains('hidden'));
  }

  function openLightbox(index: number) {
    currentVisible = getVisible();
    currentPos = currentVisible.findIndex(p => p.index === index);
    if (currentPos < 0) currentPos = 0;
    showPhoto(currentPos);
    lb.hidden = false;
    lbBackdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLightbox() {
    lb.hidden = true;
    lbBackdrop.hidden = true;
    document.body.style.overflow = '';
  }

  function showPhoto(pos: number) {
    const p = currentVisible[pos];
    if (!p) return;
    lbImg.src = p.src;
    lbImg.alt = p.alt;
    lbCat.textContent = p.cat;
    lbName.textContent = p.name;
    lbCounter.textContent = `${pos + 1} / ${currentVisible.length}`;
    lbPrev.style.display = pos === 0 ? 'none' : '';
    lbNext.style.display = pos === currentVisible.length - 1 ? 'none' : '';
  }

  function prevPhoto() { if (currentPos > 0) { currentPos--; showPhoto(currentPos); } }
  function nextPhoto() { if (currentPos < currentVisible.length - 1) { currentPos++; showPhoto(currentPos); } }

  photoData.forEach(p => {
    p.el.addEventListener('click', () => openLightbox(p.index));
  });

  lbClose.addEventListener('click', closeLightbox);
  lbBackdrop.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); prevPhoto(); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); nextPhoto(); });

  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevPhoto();
    if (e.key === 'ArrowRight') nextPhoto();
  });

  // Swipe on mobile
  let touchStartX = 0;
  lbImg.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lbImg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) dx < 0 ? nextPhoto() : prevPhoto();
  });
</script>
